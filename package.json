{
  "name": "awesome-jev",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate:og && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "generate:og": "node --experimental-strip-types scripts/generate-og.ts",
    "score:sources": "node --experimental-strip-types scripts/score-sources.ts",
    "test": "node --test scripts/*.test.mjs",
    "readme:sync": "node scripts/catalog.mjs",
    "data:check": "node scripts/catalog.mjs --check",
    "radar:scan": "node scripts/radar.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "fuse.js": "^7.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.37.0"
  },
  "description": "Curated GitHub projects and X posts about TypeSafe AI's System One model Jev — typed decisions, SDKs, demos, and integrations."
}
