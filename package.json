{
  "name": "awesome-jev",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run data:check && npm run inclusion:check && npm run news:check && npm run build:history && node --experimental-strip-types scripts/generate-sitemap.ts && npm run agents:generate && vite build && node --experimental-strip-types scripts/generate-og.ts && tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "score:sources": "node --experimental-strip-types scripts/score-sources.ts",
    "categories:classify": "node --experimental-strip-types scripts/score-sources.ts --classify",
    "categories:check": "node --experimental-strip-types scripts/score-sources.ts --check-categories",
    "test": "node --experimental-strip-types --test scripts/*.test.ts",
    "readme:sync": "node --experimental-strip-types scripts/catalog.ts",
    "data:check": "node --experimental-strip-types scripts/catalog.ts --check",
    "inclusion:check": "node --experimental-strip-types scripts/inclusion.ts --check",
    "inclusion:verify": "node --experimental-strip-types scripts/inclusion.ts --verify-changed",
    "radar:scan": "node --experimental-strip-types scripts/radar.ts",
    "alternatives:audit": "node --experimental-strip-types scripts/alternative-audit.ts",
    "news:check": "node --experimental-strip-types scripts/news-sync.ts --check",
    "news:sync": "node --experimental-strip-types scripts/news-sync.ts",
    "typecheck": "tsc -b",
    "build:history": "node --experimental-strip-types scripts/prepare-build-history.ts",
    "test:delivery": "node --experimental-strip-types scripts/verify-delivery.ts",
    "agents:generate": "node --experimental-strip-types scripts/generate-llms.ts",
    "figure:generate": "node scripts/generate-jev-figure.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@cf-wasm/resvg": "0.4.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/react-virtual": "^3.14.23",
    "@tanstack/redact": "0.2.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "fuse.js": "^7.5.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/workers-types": "5.20261026.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "wrangler": "4.153.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    }
  },
  "description": "Curated GitHub projects and Jev news about TypeSafe AI's System One model Jev — typed decisions, SDKs, demos, and integrations."
}
